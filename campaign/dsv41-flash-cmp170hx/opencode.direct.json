{
  "$schema": "https://opencode.ai/config.json",
  "model": "dsv41-direct/deepseek-v4.1-flash",
  "small_model": "dsv41-direct/deepseek-v4.1-flash",
  "default_agent": "dsv41-direct",
  "provider": {
    "dsv41-direct": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek-V4.1-Flash CMP 170HX (direct)",
      "options": {
        "baseURL": "http://100.64.0.119:8090/v1",
        "apiKey": "sk-noauth",
        "timeout": false,
        "headerTimeout": false
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek-V4.1-Flash TP4xPP2 CMP 170HX",
          "family": "deepseek",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "options": {
            "temperature": 1,
            "topP": 1
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "agent": {
    "dsv41-direct": {
      "description": "DeepSeek-V4.1-Flash on eight CMP 170HX GPUs (direct endpoint)",
      "mode": "primary",
      "model": "dsv41-direct/deepseek-v4.1-flash",
      "temperature": 1,
      "top_p": 1
    },
    "dsv41-direct-proof": {
      "description": "Read-only deterministic qualification agent for DeepSeek-V4.1-Flash",
      "mode": "primary",
      "model": "dsv41-direct/deepseek-v4.1-flash",
      "temperature": 0,
      "top_p": 1,
      "tools": {
        "*": false,
        "read": true
      }
    }
  }
}